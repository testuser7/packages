menu "Configuration options (for developers)"

config RUST_SCCACHE
	bool "Use sccache"
	help
	  Shared compilation cache; see https://github.com/mozilla/sccache

config RUST_SCCACHE_DIR
	string "Set sccache directory" if RUST_SCCACHE
	default ""
	help
	  Store sccache in this directory.
	  If not set, uses './.sccache'

config RUST_USE_PREBUILT_BINARIES
	bool "Use prebuilt Rust binaries for host"
	default y
	help
	  Use official prebuilt Rust binaries for the host toolchain on supported
	  platforms (Linux x86_64/arm64, macOS x86_64/arm64). The host libc is
	  auto-detected and the matching binary (glibc or musl) is selected
	  automatically. This significantly reduces build time by avoiding a
	  full source compilation. Disable this to force building from source
	  (e.g. for unsupported hosts or reproducibility).

config RUST_USE_PREBUILT_STD
	bool "Use prebuilt Rust standard library for target"
	default y
	depends on RUST_USE_PREBUILT_BINARIES
	help
	  Use official prebuilt rust-std binaries for the target toolchain on
	  supported platforms and ABI configurations. The target triple is
	  auto-detected from the OpenWrt target configuration. Disable this
	  option to build the Rust toolchain from source.

config RUST_BUILD_STD_FROM_SOURCE
	bool "Build Rust toolchain from source if prebuilt target std is unavailable"
	default n
	depends on RUST_USE_PREBUILT_BINARIES && RUST_USE_PREBUILT_STD
	help
	  If no compatible prebuilt target standard library is available, build
	  the complete Rust toolchain from the pinned source archive instead of
	  mixing a prebuilt host compiler with a separately built target std.
	  This is slower but uses the normal Rust bootstrap build and OpenWrt's
	  hash-verified source download. If this option is disabled, building
	  Rust for a target without a compatible prebuilt std will fail with an
	  explanation.

endmenu
